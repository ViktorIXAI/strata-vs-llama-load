{
 "exe": "$HOME/strata-0216/engine/build/cuda-compile/strata",
 "args": [
  "--pack",
  "$HOME/Strata-data/packs/iq3_s",
  "--native",
  "<model-store>/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S.gguf",
  "--ple-gguf",
  "$HOME/Strata-data/models/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00002-of-00002.gguf",
  "--expert-profile",
  "$HOME/Strata/data/expert-profile.bin",
  "--expert-cache",
